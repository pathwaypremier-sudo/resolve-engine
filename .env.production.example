# ============================================================
# Resolve Engine - Production Environment
# ============================================================

# ------------------------------------------------------------
# STRICTLY REQUIRED
# ------------------------------------------------------------

# Supabase Postgres connection string
DATABASE_URL=

# Session signing secret (min 32 chars)
SESSION_SECRET=

# ------------------------------------------------------------
# OPTIONAL (Defaults shown)
# ------------------------------------------------------------

# Base URL (Auto-derived from headers if unset)
# APP_BASE_URL=

# Storage (Default: local filesystem in .re_storage/)
# NEXT_PUBLIC_STORAGE_PROVIDER=local-fs

# NotebookLM (Default: false)
# NEXT_PUBLIC_NOTEBOOKLM_ENABLED=false

# Audit Logging (Default: 0/disabled, set to 1 to enable)
AUDIT_LOG_ENABLED=1

# ------------------------------------------------------------
# PAYMENTS (Stripe) - Uncomment when needed
# ------------------------------------------------------------
# NEXT_PUBLIC_PAYMENTS_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

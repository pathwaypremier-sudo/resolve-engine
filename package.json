{
  "name": "resolve-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:types": "tsc --noEmit",
    "check:copy": "node scripts/check-copy.mjs",
    "check:triggers": "npx -y tsx scripts/check-trigger-snapshot.ts",
    "check:verticals": "node scripts/check-vertical-leaks.mjs",
    "snapshot:triggers:update": "npx -y tsx scripts/check-trigger-snapshot.ts --update",
    "rc-e2e": "npx -y tsx scripts/verify-e2e-rc.ts",
    "rc-smoke": "node scripts/rc-smoke.mjs",
    "rc-final": "npx -y cross-env RC_E2E=1 npm run rc-smoke"
  },
  "dependencies": {
    "autoprefixer": "^10.4.23",
    "better-sqlite3": "^12.6.2",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "next": "^14.2.35",
    "pdfjs-dist": "^5.4.530",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
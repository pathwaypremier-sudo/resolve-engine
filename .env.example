# ============================================================
# Resolve Engine Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ------------------------------------------------------------

# Session signing secret (min 32 chars recommended)
# Used to sign HttpOnly session cookies
SESSION_SECRET=

# Base URL for the application (for Stripe redirect URLs)
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# PERSISTENCE & STORAGE
# ------------------------------------------------------------

# Persistence Strategy: 'local' (localStorage) or 'remote' (API)
NEXT_PUBLIC_PERSISTENCE_MODE=local

# Storage Provider: 'local-fs' or 's3' (requires secrets in real env)
NEXT_PUBLIC_STORAGE_PROVIDER=local-fs

# ------------------------------------------------------------
# STRIPE CONFIGURATION
# Required if payments/checkout are enabled
# ------------------------------------------------------------

# Stripe API keys (from Stripe Dashboard)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Webhook signing secret (from Stripe CLI or Dashboard)
# Required when WEBHOOK_ENABLED=1 in production
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for each tier (from Stripe Dashboard > Products)
STRIPE_PRICE_APPEAL_BUILDER=
STRIPE_PRICE_MANAGED=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ANNUAL_ACCESS=

# Payments Provider: 'stub' or 'stripe'
NEXT_PUBLIC_PAYMENTS_PROVIDER=stub

# ------------------------------------------------------------
# MANAGED DOMAINS
# Required for Managed tier case email addresses
# ------------------------------------------------------------

# Comma-separated list of domains for Managed tier allocation
# Domains are allocated round-robin to cases
MANAGED_DOMAIN_POOL=resolveapp.com,resolvecases.com

# Default domain for non-Managed tier case emails
CASE_EMAIL_DOMAIN=resolveapp.com

# ------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------

# Enable webhook processing in production
# Default: 0 (disabled). Set to 1 to enable.
WEBHOOK_ENABLED=0

# Rate limit for webhook requests per IP per minute
WEBHOOK_RL_PER_MINUTE=60

# ------------------------------------------------------------
# DEV-ONLY (NOT FOR PRODUCTION)
# ------------------------------------------------------------

# HMAC secret for dev webhook testing (non-Stripe)
# This is a fallback for local development when not using Stripe CLI
WEBHOOK_SECRET=

# Dev Tools (Optional)
# NEXT_PUBLIC_DENY_ALL_POLICIES=false

# ------------------------------------------------------------
# BRAIN / NOTEBOOKLM CONFIGURATION
# ------------------------------------------------------------

# Brain Provider: 'local' (default) or 'notebooklm'
BRAIN_PROVIDER=local

# Brain Pack Version (for reproducibility)
BRAIN_PACK_VERSION=v1

# NotebookLM Config (Required if BRAIN_PROVIDER=notebooklm)
NOTEBOOKLM_PROJECT_ID=
NOTEBOOKLM_LOCATION=
NOTEBOOKLM_NOTEBOOK_BASE_URL=https://notebooklm.google.com/notebook

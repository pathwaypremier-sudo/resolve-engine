# .env.example
# Safe defaults for local development.
# DO NOT ADD REAL SECRETS HERE.

# Persistence Strategy: 'local' (localStorage) or 'remote' (API)
NEXT_PUBLIC_PERSISTENCE_MODE=local

# Storage Provider: 'local-fs' or 's3' (requires secrets in real env)
NEXT_PUBLIC_STORAGE_PROVIDER=local-fs

# Payments Provider: 'stub' or 'stripe'
# Default: stub
NEXT_PUBLIC_PAYMENTS_PROVIDER=stub

# Payment Secrets (Required only if NEXT_PUBLIC_PAYMENTS_PROVIDER=stripe)
# IMPORTANT: These should be set in the deployment environment and NEVER committed.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Dev Tools (Optional)
# NEXT_PUBLIC_DENY_ALL_POLICIES=false
